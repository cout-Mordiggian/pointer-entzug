// Gradle mit Kotlin-DSL, dasselbe Projekt wie in pom.xml.vorlage.
// Vorlage: beim Kopieren in ein eigenes Projekt in build.gradle.kts umbenennen
// (dazu settings.gradle.kts.vorlage als settings.gradle.kts).

plugins {
    java
    application
}

group = "de.beispiel"
version = "1.0-SNAPSHOT"

repositories {
    mavenCentral()
}

java {
    toolchain {
        // Fehlt ein JDK 21, laedt Gradle eines herunter. Das klappt nur mit dem
        // foojay-Plugin aus settings.gradle.kts, sonst bricht der Build ab.
        languageVersion = JavaLanguageVersion.of(21)
    }
}

dependencies {
    testImplementation("org.junit.jupiter:junit-jupiter:6.1.3")
    testRuntimeOnly("org.junit.platform:junit-platform-launcher")
}

application {
    // Fuer "gradle run": deine Klasse mit main eintragen
    mainClass = "de.beispiel.Main"
}

tasks.test {
    useJUnitPlatform()      // ohne diese Zeile werden JUnit-Tests ignoriert
    testLogging {
        events("passed", "skipped", "failed")
    }
}
